<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Reso360Spout</AssemblyName>
    <RootNamespace>Reso360Spout</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ResonitePath)\rml_libs\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)\Elements.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)\FrooxEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ResoniteModLoader">
      <HintPath>$(ResonitePath)\Libraries\ResoniteModLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ResoniteModSettings">
      <HintPath>$(ResonitePath)\rml_mods\ResoniteModSettings.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Unity references - these are only available in the Renderer process -->
    <!-- We mark them as optional so the mod can load in the main process -->
    <Reference Include="UnityEngine">
      <HintPath>$(ResoniteRendererPath)\Renderite.Renderer_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ResoniteRendererPath)\Renderite.Renderer_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ResoniteRendererPath)\Renderite.Renderer_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(ResoniteRendererPath)\Renderite.Renderer_Data\Managed\Renderite.Shared.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <!-- InterprocessLib for IPC (Main Process) - Optional, loaded at runtime via reflection -->
    <Reference Include="InterProcessLib.FrooxEngine" Condition="Exists('$(ResonitePath)\BepInEx\Plugins\InterprocessLib.BepisLoader\InterprocessLib.FrooxEngine.dll')">
      <HintPath>$(ResonitePath)\BepInEx\Plugins\InterprocessLib.BepisLoader\InterprocessLib.FrooxEngine.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="InterprocessLib.BepisLoader_Extensions.dll" Condition="Exists('$(ResonitePath)\BepInEx\Plugins\InterprocessLib.BepisLoader\InterprocessLib.BepisLoader_Extensions.dll')">
      <HintPath>$(ResonitePath)\BepInEx\Plugins\InterprocessLib.BepisLoader\InterprocessLib.BepisLoader_Extensions.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <!-- InterprocessLib for IPC (Renderer Process) - Optional, loaded at runtime -->
    <Reference Include="InterprocessLib.Unity" Condition="Exists('$(ResoniteRendererPath)\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.Unity.dll')">
      <HintPath>$(ResoniteRendererPath)\BepInEx\plugins\InterprocessLib.BepInEx\InterprocessLib.Unity.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Reso360SpoutBootstrap\**" />
    <Compile Remove="Reso360Spout.Shared\**" />
    <None Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Reso360SpoutBootstrap\**" />
  </ItemGroup>
  <!-- Explicitly include Shared files -->
  <ItemGroup>
    <Compile Include="Reso360Spout.Shared\CameraCommand.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Set ResonitePath to your Resonite installation directory -->
    <!-- You can set this via: dotnet build /p:ResonitePath="C:\Path\To\Resonite" -->
    <!-- Or set it as an environment variable, or edit this file directly -->
    <ResonitePath Condition="'$(ResonitePath)' == ''">G:\SteamLibrary\steamapps\common\Resonite</ResonitePath>
    <ResoniteRendererPath Condition="'$(ResoniteRendererPath)' == ''">G:\SteamLibrary\steamapps\common\Resonite\Renderer</ResoniteRendererPath>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <ModOutputPath Condition="'$(ModOutputPath)' == ''">$(ResonitePath)\rml_mods</ModOutputPath>
      <RendererManagedPath Condition="'$(RendererManagedPath)' == ''">$(ResoniteRendererPath)\Renderite.Renderer_Data\Managed</RendererManagedPath>
      <RendererPluginsPath Condition="'$(RendererPluginsPath)' == ''">$(ResoniteRendererPath)\Renderite.Renderer_Data\Plugins\x86_64</RendererPluginsPath>
    </PropertyGroup>
    <!-- Copy to rml_mods for main process -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputPath)" />
    <!-- Copy to Renderer Managed folder for renderer process -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RendererManagedPath)" />
    <!-- Copy KlakSpout.dll to Renderer Plugins folder if it exists -->
    <Copy SourceFiles="$(ProjectDir)KlakSpout.dll" 
          DestinationFolder="$(RendererPluginsPath)" 
          Condition="Exists('$(ProjectDir)KlakSpout.dll')" />
  </Target>
</Project>
